{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/usg/phase2-exit-acceptance-report-1.0.0.schema.json",
  "title": "USG Phase 2 Exit Acceptance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "generated_at", "repository", "commit", "phase", "status",
    "checks_passed", "checks_failed", "checks_total", "independent_evidence_axes",
    "truth_promotion_performed", "conflict_winner_selection_performed",
    "human_review_gate_required", "results"
  ],
  "properties": {
    "contract": { "const": "USG-PHASE-2-EXIT-ACCEPTANCE/1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "repository": { "type": "string" },
    "commit": { "type": ["string", "null"] },
    "phase": { "const": "2" },
    "status": { "enum": ["ACCEPTED", "NOT_ACCEPTED"] },
    "checks_passed": { "type": "integer", "minimum": 0 },
    "checks_failed": { "type": "integer", "minimum": 0 },
    "checks_total": { "type": "integer", "minimum": 1 },
    "independent_evidence_axes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 7,
      "uniqueItems": true
    },
    "truth_promotion_performed": { "const": false },
    "conflict_winner_selection_performed": { "const": false },
    "human_review_gate_required": { "const": false },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "status", "return_code", "duration_seconds", "output_tail"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "status": { "enum": ["PASS", "FAIL"] },
          "return_code": { "type": "integer" },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "output_tail": { "type": "string" }
        }
      }
    }
  }
}
