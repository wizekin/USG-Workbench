{
  "graph_version": "1.0.0",
  "description": "Versioned dependency profiles for currently registered interpreter targets. Dependencies describe required upstream artifacts, not necessarily wall-clock execution order.",
  "profiles": {
    "phase4-bounded-interpreter": {
      "pipeline_contract": "USG-INTERPRET/0.1.0",
      "pipeline_version": "usg-interpretation/0.1.0",
      "stages": {
        "source_ingestion": {
          "depends_on": []
        },
        "segmentation": {
          "depends_on": ["source_ingestion"]
        },
        "lexical": {
          "depends_on": ["source_ingestion"]
        },
        "mentions": {
          "depends_on": ["lexical"]
        },
        "discourse": {
          "depends_on": ["lexical", "segmentation"]
        },
        "syntax": {
          "depends_on": ["lexical"]
        },
        "semantic_composition": {
          "depends_on": ["lexical", "syntax"]
