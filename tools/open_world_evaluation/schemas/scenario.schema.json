{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USG Open-World Scenario v1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 12
    },
    "population": {
      "enum": [
        "unconstrained_random",
        "naturalistic",
        "controlled_diagnostic"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "seed_mode": {
          "enum": [
            "entropy",
            "explicit",
            "derived",
            "imported"
          ]
        },
        "master_seed": {
          "type": "string",
          "minLength": 16
        },
        "case_seed": {
          "type": "string",
          "minLength": 16
        },
        "generation_trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mutation_ops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "version",
        "seed_mode",
        "master_seed",
        "case_seed"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "open_license_dataset",
            "public_domain",
            "public_documentation",
            "diagnostic_fixture",
            "authorized_user_supplied"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "license_status": {
          "enum": [
            "approved",
            "restricted",
            "unknown"
          ]
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "privacy_review_status": {
          "enum": [
            "approved",
            "no_personal_data",
            "rejected",
            "pending"
          ]
        },
        "attribution": {
          "type": "string"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "source_id"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "utf8_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "language_hint": {
          "type": "string"
        },
        "prior_turns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "text",
        "utf8_sha256"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "component_id": {
          "type": "string"
        },
        "component_version": {
          "type": "string"
        },
        "entry_point": {
          "type": "string"
        },
        "interface": {
          "enum": [
            "python_api",
            "cli",
            "http_api",
            "browser_ui",
            "javascript_api",
            "model_api",
            "adapter",
            "storage_api",
            "other"
          ]
        },
        "contract_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "component_id",
        "component_version",
        "entry_point",
        "interface"
      ],
      "additionalProperties": false
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unclassified": {
          "type": "boolean"
        }
      },
      "required": [
        "labels",
        "unclassified"
      ],
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "none",
            "exact_match",
            "structural",
            "metamorphic",
            "external_reference",
            "human_rubric"
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "oracle_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "independent"
      ],
      "additionalProperties": false
    },
    "resource_limits": {
      "type": "object",
      "properties": {
        "wall_time_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memory_megabytes": {
          "type": "integer",
          "minimum": 16
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "network_access": {
          "const": false
        }
      },
      "required": [
        "wall_time_seconds",
        "memory_megabytes",
        "max_input_bytes",
        "network_access"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "population",
    "created_at",
    "generator",
    "source",
    "input",
    "target",
    "taxonomy",
    "oracle",
    "resource_limits"
  ],
  "additionalProperties": false
}
