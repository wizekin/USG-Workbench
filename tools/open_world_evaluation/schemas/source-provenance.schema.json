{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"USG Open-World Source Provenance v1.0.0",
  "type":"object",
  "properties":{
    "kind":{"enum":["synthetic","open_license_dataset","public_domain","public_documentation","diagnostic_fixture","authorized_user_supplied"]},
    "source_id":{"type":"string","minLength":1},
    "source_url":{"type":"string","format":"uri"},
    "retrieved_at":{"type":"string","format":"date-time"},
    "license_status":{"enum":["approved","restricted","unknown"]},
    "redistribution_allowed":{"type":"boolean"},
    "privacy_review_status":{"enum":["approved","no_personal_data","rejected","pending"]},
    "attribution":{"type":"string"},
    "content_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "transformations":{"type":"array","items":{"type":"string"}},
    "permission_reference":{"type":"string"}
  },
  "required":["kind","source_id"],
  "additionalProperties":false
}