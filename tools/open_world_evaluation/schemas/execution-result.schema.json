{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USG Open-World Execution Result v1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 12
    },
    "case_id": {
      "type": "string",
      "minLength": 12
    },
    "target": {
      "type": "object",
      "properties": {
        "component_id": {
          "type": "string"
        },
        "component_version": {
          "type": "string"
        },
        "entry_point": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "component_id",
        "component_version",
        "entry_point",
        "commit_sha"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "completed",
        "unsupported",
        "ambiguous",
        "abstained",
        "partial",
        "invalid_output",
        "timeout",
        "crashed",
        "infrastructure_error",
        "not_executed"
      ]
    },
    "execution": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        }
      },
      "required": [
        "duration_ms",
        "timed_out"
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "stdout_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stderr_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_media_type": {
          "type": "string"
        },
        "inline_output": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "output_sha256",
        "output_media_type"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "schema_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_spans_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "graph_invariants_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "provenance_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "persistence_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "replay_matches": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "scoring": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric_id": {
            "type": "string"
          },
          "method": {
            "enum": [
              "exact_match",
              "precision_recall_f1",
              "structural_invariants",
              "metamorphic",
              "external_reference",
              "human_rubric"
            ]
          },
          "value": {
            "type": "number"
          },
          "oracle_id": {
            "type": "string"
          },
          "oracle_independent": {
            "type": "boolean"
          }
        },
        "required": [
          "metric_id",
          "method",
          "value",
          "oracle_id",
          "oracle_independent"
        ],
        "additionalProperties": false
      }
    },
    "failure_category": {
      "enum": [
        "segmentation",
        "lexical_morphology",
        "syntax_attachment",
        "semantic_role_frame",
        "nominal_modifier",
        "operator_scope",
        "discourse_reference",
        "ambiguity_abstention",
        "source_span_provenance",
        "projection_serialization",
        "persistence_replay",
        "api_cli_ui",
        "multilingual",
        "robustness_resource",
        "safety_boundary",
        "oracle_defect",
        "infrastructure",
        "unknown_new_family"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "name",
          "uri",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "case_id",
    "target",
    "started_at",
    "finished_at",
    "outcome",
    "execution",
    "capture",
    "validation",
    "scoring",
    "artifacts"
  ],
  "additionalProperties": false
}
