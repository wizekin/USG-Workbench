{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USG Versioned Lexical Resource v0.1.0",
  "type": "object",
  "required": ["resource_id", "version", "provenance", "entries", "morphology_rules"],
  "properties": {
    "resource_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "provenance": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["language", "form", "lemma", "part_of_speech", "sense_id", "features"],
        "properties": {
          "language": {"enum": ["en", "ar"]},
          "form": {"type": "string", "minLength": 1},
          "lemma": {"type": "string", "minLength": 1},
          "part_of_speech": {"enum": ["NOUN", "PROPN", "VERB", "ADJ", "ADV", "PRON", "ADP", "DET", "NUM", "OTHER"]},
          "sense_id": {"type": "string", "minLength": 1},
          "concept_ref": {"type": ["string", "null"]},
          "features": {"type": "object", "additionalProperties": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "morphology_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "language", "position", "affix", "target_part_of_speech", "features"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "language": {"enum": ["en", "ar"]},
          "position": {"enum": ["prefix", "suffix"]},
          "affix": {"type": "string", "minLength": 1},
          "target_part_of_speech": {"enum": ["NOUN", "PROPN", "VERB", "ADJ", "ADV", "PRON", "ADP", "DET", "NUM", "OTHER"]},
          "features": {"type": "object", "additionalProperties": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
