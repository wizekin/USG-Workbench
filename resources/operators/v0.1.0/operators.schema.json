{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USG Scoped Operator Lexicon v0.1.0",
  "type": "object",
  "required": ["resource_id", "version", "provenance", "operators"],
  "properties": {
    "resource_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "provenance": {"type": "string", "minLength": 1},
    "operators": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["language", "form", "operator_type", "value", "scope_kind", "target_pos", "condition"],
        "properties": {
          "language": {"enum": ["en", "ar"]},
          "form": {"type": "string", "minLength": 1},
          "operator_type": {"enum": ["NEGATION", "MODALITY", "TENSE", "ASPECT", "QUANTIFIER", "AUXILIARY"]},
          "value": {"type": "string", "minLength": 1},
          "scope_kind": {"enum": ["PREDICATE", "ARGUMENT"]},
          "target_pos": {"enum": ["NOUN", "PROPN", "VERB"]},
          "condition": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
