  "rules": [
    {
      "rule_id": "benchmark-rule:modus-ponens",
      "version": "1.0.0",
      "title": "Modus ponens",
      "category": "propositional",
      "description": "From an eligible assertion of A and an eligible assertion of the directed conditional A → B, derive B only in the exact same context and only when polarity, attribution, modality, and relevant scope are preserved.",
      "activation_state": "SPECIFIED_NOT_EXECUTABLE",
      "variables": [
        {
          "name": "A",
          "value_type": "expression_ref",
          "required": true,
          "description": "Antecedent expression identity."
        },
        {
          "name": "B",
          "value_type": "expression_ref",
          "required": true,
          "description": "Consequent expression identity."
        },
        {
          "name": "C",
          "value_type": "context_ref",
          "required": true,
          "description": "Exact shared context reference."
        }
      ],
      "premises": [
        {
          "premise_id": "asserted-antecedent",
          "order": 0,
          "required": true,
          "match": {
            "record_type": "assertion",
            "field_bindings": {
              "expression_ref": "A",
              "context_ref": "C"
            },
            "fixed_fields": {
              "eligibility": "RULE_ELIGIBLE_ASSERTION"
            }
          }
        },
        {
          "premise_id": "asserted-conditional",
          "order": 1,
          "required": true,
          "match": {
            "record_type": "assertion",
            "field_bindings": {
              "expression_ref": "conditional-expression",
              "context_ref": "C"
            },
            "fixed_fields": {
              "eligibility": "RULE_ELIGIBLE_ASSERTION"
            }
          }
        },
        {
          "premise_id": "conditional-expression",
          "order": 2,
          "required": true,
          "match": {
            "record_type": "expression",
            "field_bindings": {
              "id": "conditional-expression",
              "antecedent_ref": "A",
              "consequent_ref": "B"
            },
            "fixed_fields": {
              "operator": "IMPLIES"
            }
          }
        }
      ],
      "constraints": [
        {
          "constraint_id": "same-context",
          "kind": "context_equal",
          "parameters": {
            "left": "asserted-antecedent",
            "right": "asserted-conditional"
          },
          "failure_diagnostic": "RULE_CONTEXT_MISMATCH"
        },
        {
          "constraint_id": "directed-antecedent",
          "kind": "operator_direction",
          "parameters": {
            "operator": "IMPLIES",
            "antecedent": "A",
            "consequent": "B"
          },
          "failure_diagnostic": "RULE_CONDITIONAL_DIRECTION_MISMATCH"
        },
        {
          "constraint_id": "premises-eligible",
          "kind": "status_eligible",
          "parameters": {
            "premises": [
              "asserted-antecedent",
              "asserted-conditional"
            ]
          },
          "failure_diagnostic": "RULE_PREMISE_INELIGIBLE"
        },
        {
          "constraint_id": "context-preserved",
          "kind": "context_preserved",
          "parameters": {
            "source": "C",
            "target": "C"
          },
          "failure_diagnostic": "RULE_CONTEXT_TRANSFER_FORBIDDEN"
        }
      ],
      "scope_context_requirements": {
        "context": "same_exact_reference",
        "attribution": "preserve_exact",
        "polarity": "preserve_exact",
        "modality": "preserve_exact",
        "quantifier_scope": "preserve_exact",
        "temporal_scope": "preserve_exact",
        "role_binding": "preserve_order",
        "world_assumption": "OPEN_ONLY"
      },
      "conclusion_templates": [
        {
          "template_id": "derive-consequent",
          "output_kind": "conclusion_candidate",
          "template": {
            "record_type": "conclusion_candidate",
            "expression_ref": "$B",
            "context_ref": "$C",
            "derivation_required": true
          },
          "epistemic_effect": "DERIVED_NOT_VERIFIED",
          "truth_promotion": false
        }
      ],
      "assumptions": {
        "world_assumption": "OPEN",
        "required_task_assumptions": [],
        "closed_domain_policy_required": false,
        "closed_domain_policy_ref": null,
        "independence_policy_required": false
      },
      "non_applicability": [
        {
          "condition": "Antecedent assertion is absent, ineligible, negated, differently attributed, modal-incompatible, or in another context.",
          "diagnostic": "RULE_PREMISE_INELIGIBLE"
        },
        {
          "condition": "The conditional direction or operand identity does not match exactly.",
          "diagnostic": "RULE_CONDITIONAL_DIRECTION_MISMATCH"
        },
        {
          "condition": "Only the consequent is asserted; the converse is never inferred.",
          "diagnostic": "RULE_CONVERSE_NOT_LICENSED"
        }
