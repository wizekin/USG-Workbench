      "exact_context_reference",
      "exact_context_kind",
      "exact_commitment",
      "exact_attributed_referent"
    ],
    "eligible_epistemic_statuses": [
      "SOURCE_ASSERTED",
      "DISPUTED"
    ],
    "winner_selection": "FORBIDDEN",
