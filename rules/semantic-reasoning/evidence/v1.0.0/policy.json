    "corroboration_default": "NOT_ESTABLISHED"
  },
  "verification": {
    "external_declarations_are_authoritative": false,
    "unregistered_verifier_effect": "DECLARED_UNVERIFIED",
    "verification_default": "NOT_PROVIDED"
  },
  "invariants": {
    "truth_promotion": false,
    "semantic_support_from_quote_alignment": false,
    "corroboration_without_independence": false,
    "implicit_source_independence": false,
    "conflict_winner_selection": false,
    "human_review_gate": false,
    "canonical_document_mutation": false,
    "semantic_truncation": false
  }
