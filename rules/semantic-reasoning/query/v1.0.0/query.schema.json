{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/USG-Workbench/semantic-query-1.0.0.schema.json",
  "title": "USG Structured Query 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "goal",
    "inference_task"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression_ref",
        "context_ref",
        "context_kind",
        "commitment"
      ],
      "properties": {
        "expression_ref": {
          "type": "string",
          "minLength": 1
        },
        "context_ref": {
          "type": "string",
          "minLength": 1
        },
        "context_kind": {
          "type": "string",
          "minLength": 1
        },
        "commitment": {
          "enum": [
            "AUTHOR",
            "ATTRIBUTED",
            "NONE"
          ]
        },
        "attributed_to_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "commitment": {
                "const": "ATTRIBUTED"
              }
            },
            "required": [
              "commitment"
            ]
          },
          "then": {
            "required": [
              "attributed_to_ref"
            ]
          },
          "else": {
            "not": {
              "required": [
                "attributed_to_ref"
              ]
            }
          }
        }
      ]
    },
    "inference_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "rule_ids",
        "world_assumption",
        "allow_inferred_premises",
        "evidence_assessment"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "world_assumption": {
          "const": "OPEN"
        },
        "max_rule_applications": {
          "type": "integer",
          "minimum": 0
        },
        "allow_inferred_premises": {
          "const": false
        },
        "evidence_assessment": {
          "const": false
        }
      }
    }
  }
}
