{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/USG-Workbench/semantic-rule-execution-activation-1.0.0.schema.json",
  "title": "USG Rule Execution Activation 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation_id",
    "activation_version",
    "rule_model_version",
    "registry_id",
    "registry_version",
    "semantics_id",
    "semantics_version",
    "usg_profile",
    "execution_enabled",
    "rules",
    "invariants"
  ],
  "properties": {
    "activation_id": {
      "type": "string",
      "minLength": 1
    },
    "activation_version": {
      "const": "1.0.0"
    },
    "rule_model_version": {
      "const": "USG-RULE/1.0.0"
    },
    "registry_id": {
      "const": "USG-SEMANTIC-RULE-REGISTRY"
    },
    "registry_version": {
      "const": "1.0.0"
    },
    "semantics_id": {
      "const": "USG-RULE-SEMANTICS"
    },
    "semantics_version": {
      "const": "1.0.0"
    },
    "usg_profile": {
      "const": "USG-SEM/1.0"
    },
    "execution_enabled": {
      "const": true
    },
    "rules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "version",
          "enabled",
          "handler",
          "handler_status"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "benchmark-rule:modus-ponens",
              "benchmark-rule:and-elimination-left"
            ]
          },
          "version": {
            "const": "1.0.0"
          },
          "enabled": {
            "const": true
          },
          "handler": {
            "enum": [
              "modus_ponens",
              "and_elimination_left"
            ]
          },
          "handler_status": {
            "const": "IMPLEMENTED"
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "exact_typed_matching",
        "source_asserted_only",
        "inferred_premise_chaining",
        "automatic_truth_promotion",
        "implicit_closed_world",
        "semantic_truncation",
        "preserve_all_input_records",
        "human_review_gate",
        "evidence_assessment",
        "canonical_schema_mutation"
      ],
      "properties": {
        "deterministic": {
          "const": true
        },
        "exact_typed_matching": {
          "const": true
        },
        "source_asserted_only": {
          "const": true
        },
        "inferred_premise_chaining": {
          "const": false
        },
        "automatic_truth_promotion": {
          "const": false
        },
        "implicit_closed_world": {
          "const": false
        },
        "semantic_truncation": {
          "const": false
        },
        "preserve_all_input_records": {
          "const": true
        },
        "human_review_gate": {
          "const": false
        },
        "evidence_assessment": {
          "const": false
        },
        "canonical_schema_mutation": {
          "const": false
        }
      }
    }
  }
}
