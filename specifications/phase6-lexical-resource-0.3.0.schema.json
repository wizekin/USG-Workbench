{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/USG-Workbench/specifications/phase6-lexical-resource-0.3.0.schema.json",
  "title": "USG Phase 6 Candidate Bilingual Lexical and Morphology Resource 0.3.0",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "contract",
    "status",
    "provenance",
    "entries",
    "morphology_rules"
  ],
  "properties": {
    "resource_id": {
      "const": "phase6.lexicon.bilingual.candidate"
    },
    "version": {
      "const": "0.3.0"
    },
    "contract": {
      "const": "USG-INTERPRET/0.3.0"
    },
    "status": {
      "const": "CANDIDATE"
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "benchmark",
        "language_profiles",
        "limitations"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "benchmark": {
          "const": "benchmarks/phase6-interpretation-v0.3.0/corpus.json"
        },
        "language_profiles": {
          "type": "object",
          "required": [
            "en",
            "ar"
          ],
          "properties": {
            "en": {
              "const": "en/standard-written-1.0"
            },
            "ar": {
              "const": "ar/modern-standard-1.0"
            }
          },
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "language",
          "language_profile",
          "form",
          "lemma",
          "part_of_speech",
          "sense_id",
          "features",
          "status",
          "evidence"
        ],
        "properties": {
          "language": {
            "enum": [
              "en",
              "ar"
            ]
          },
          "language_profile": {
            "enum": [
              "en/standard-written-1.0",
              "ar/modern-standard-1.0"
            ]
          },
          "form": {
            "type": "string",
            "minLength": 1
          },
          "lemma": {
            "type": "string",
            "minLength": 1
          },
          "part_of_speech": {
            "enum": [
              "NOUN",
              "PROPN",
              "VERB",
              "ADJ",
              "ADV",
              "PRON",
              "ADP",
              "DET",
              "NUM",
              "OTHER"
            ]
          },
          "sense_id": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "status": {
            "const": "CANDIDATE"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "fixture_id",
                "start",
                "end",
                "surface"
              ],
              "properties": {
                "fixture_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "surface": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "morphology_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "language",
          "language_profile",
          "pattern",
          "status",
          "evidence_fixture_ids"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "en",
              "ar"
            ]
          },
          "language_profile": {
            "type": "string"
          },
          "pattern": {
            "type": "object",
            "required": [
              "kind",
              "value",
              "condition",
              "example_forms"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "prefix",
                  "suffix"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "example_forms": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "status": {
            "const": "CANDIDATE"
          },
          "evidence_fixture_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
