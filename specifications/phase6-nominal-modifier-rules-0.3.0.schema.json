{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/USG-Workbench/specifications/phase6-nominal-modifier-rules-0.3.0.schema.json",
  "title": "USG Phase 6 Candidate Nominal and Modifier Rules 0.3.0",
  "type": "object",
  "required": [
    "resource_id",
    "version",
    "contract",
    "status",
    "provenance",
    "rules"
  ],
  "properties": {
    "resource_id": {
      "const": "phase6.nominal-modifier-rules.candidate"
    },
    "version": {
      "const": "0.3.0"
    },
    "contract": {
      "const": "USG-INTERPRET/0.3.0"
    },
    "status": {
      "const": "CANDIDATE"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "language",
          "construction_id",
          "family",
          "pattern",
          "head_role",
          "modifier_role",
          "required_evidence",
          "ambiguity_policy",
          "status"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "en",
              "ar"
            ]
          },
          "construction_id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "ADJECTIVE_MODIFIER",
              "POSSESSION",
              "NOUN_COMPOUND",
              "PREPOSITIONAL_MODIFIER",
              "TEMPORAL_MODIFIER"
            ]
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "head_role": {
            "type": "string",
            "minLength": 1
          },
          "modifier_role": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ambiguity_policy": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "CANDIDATE"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
