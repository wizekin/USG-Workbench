{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wizekin/USG-Workbench/blob/main/specifications/phase6-independent-gold-manifest-1.0.schema.json",
  "title": "USG Phase 6 Independent Semantic Gold Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "version", "contract", "status", "source", "rights", "annotation", "profiles", "cases", "leakage_audit"],
  "properties": {
    "manifest_id": {"const": "usg-phase6-independent-semantic-gold"},
    "version": {"const": "1.0.0"},
    "contract": {"const": "USG-INTERPRET/0.3.0"},
    "status": {"const": "FROZEN_INDEPENDENT_GOLD"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_name", "release", "source_url", "source_license", "source_item_ids_pinned", "acquisition_method"],
      "properties": {
        "dataset_name": {"type": "string", "minLength": 3},
        "release": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "source_license": {"type": "string", "minLength": 2},
        "source_item_ids_pinned": {"const": true},
        "acquisition_method": {"enum": ["official_public_release", "official_repository_release", "provider_authorized_release"]}
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["license_verified", "public_redistribution_allowed", "automated_evaluation_allowed", "attribution_text"],
      "properties": {
        "license_verified": {"const": true},
        "public_redistribution_allowed": {"const": true},
        "automated_evaluation_allowed": {"const": true},
        "attribution_text": {"type": "string", "minLength": 10}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["guideline_version", "annotation_method", "independent_annotators_per_case", "adjudication", "model_labels_used", "development_fixture_independence", "raw_independent_labels_preserved"],
      "properties": {
        "guideline_version": {"type": "string", "minLength": 1},
        "annotation_method": {"const": "independent_human_annotation"},
        "independent_annotators_per_case": {"const": 2},
        "adjudication": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "method", "separate_adjudicator", "disagreements_preserved"],
          "properties": {
            "status": {"const": "complete"},
            "method": {"enum": ["third_annotator", "documented_consensus_after_blind_independent_labels"]},
            "separate_adjudicator": {"type": "boolean"},
            "disagreements_preserved": {"const": true}
          }
        },
        "model_labels_used": {"const": false},
        "development_fixture_independence": {"const": true},
        "raw_independent_labels_preserved": {"const": true}
      }
    },
    "profiles": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["language", "construction_id", "positive", "negative", "ambiguous", "independent_annotator_ids", "adjudicator_id", "agreement_report"],
        "properties": {
          "language": {"enum": ["en", "ar"]},
          "construction_id": {"type": "string", "minLength": 5},
          "positive": {"type": "integer", "minimum": 20},
          "negative": {"type": "integer", "minimum": 20},
          "ambiguous": {"type": "integer", "minimum": 10},
          "independent_annotator_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "adjudicator_id": {"type": "string", "minLength": 2},
          "agreement_report": {"type": "string", "minLength": 5}
        }
      }
    },
    "cases": {
      "type": "object", "additionalProperties": false,
      "required": ["case_count", "case_file", "sha256", "exact_source_spans_verified", "development_overlap_count"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 500},
        "case_file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "exact_source_spans_verified": {"const": true},
        "development_overlap_count": {"const": 0}
      }
    },
    "leakage_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_predictions_hidden_during_annotation", "source_ids_checked", "normalized_text_checked", "result"],
      "properties": {
        "candidate_predictions_hidden_during_annotation": {"const": true},
        "source_ids_checked": {"const": true},
        "normalized_text_checked": {"const": true},
        "result": {"const": "NO_DEVELOPMENT_LEAKAGE"}
      }
    }
  }
}
