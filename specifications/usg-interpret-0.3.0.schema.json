{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/USG-Workbench/specifications/usg-interpret-0.3.0.schema.json",
  "title": "USG Interpretation Result Envelope 0.3.0",
  "type": "object",
  "required": [
    "pipelineContract",
    "pipelineVersion",
    "languageProfile",
    "completionStatus",
    "sourceSnapshot",
    "interpretationGraph",
    "stages",
    "diagnostics",
    "alternatives",
    "resourceLimits",
    "projection"
  ],
  "properties": {
    "pipelineContract": {
      "const": "USG-INTERPRET/0.3.0"
    },
    "pipelineVersion": {
      "type": "string",
      "minLength": 1
    },
    "languageProfile": {
      "type": "string",
      "pattern": "^(en|ar)\\/[A-Za-z0-9._-]+$"
    },
    "completionStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "AMBIGUOUS",
        "UNSUPPORTED",
        "INVALID_INPUT",
        "INCOMPLETE_RESOURCE_LIMIT",
        "FAILED_VALIDATION"
      ]
    },
    "sourceSnapshot": {
      "type": "object",
      "required": [
        "sourceRef",
        "sourceText",
        "sourceSha256",
        "offsetUnit"
      ],
      "properties": {
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceText": {
          "type": "string"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "offsetUnit": {
          "const": "unicode_code_point"
        }
      },
      "additionalProperties": false
    },
    "interpretationGraph": {
      "$ref": "usg-interpret-expression-graph-0.3.0.schema.json"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stageId",
          "status",
          "implementationVersion"
        ],
        "properties": {
          "stageId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "AMBIGUOUS",
              "SKIPPED",
              "FAILED"
            ]
          },
          "implementationVersion": {
            "type": "string",
            "minLength": 1
          },
          "resourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "resourceId",
                "version",
                "sha256"
              ],
              "properties": {
                "resourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "diagnosticRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "sourceSpans": {
            "type": "array",
            "items": {
              "$ref": "usg-interpret-expression-graph-0.3.0.schema.json#/$defs/span"
            }
          },
          "details": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "alternativeId",
          "graphRootRefs",
          "ranking"
        ],
        "properties": {
          "alternativeId": {
            "type": "string",
            "minLength": 1
          },
          "graphRootRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ranking": {
            "type": "object",
            "required": [
              "method",
              "rank"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "scoreMeaning": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "resourceLimits": {
      "type": "object",
      "required": [
        "declared",
        "interrupted"
      ],
      "properties": {
        "declared": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "integer",
              "number",
              "null"
            ]
          }
        },
        "interrupted": {
          "type": "boolean"
        },
        "interruptionReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "required": [
        "status",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_ATTEMPTED",
            "LOSSLESS",
            "BLOCKED",
            "LOSSY"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "canonicalDocument": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "LOSSLESS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "canonicalDocument": {
                "type": "object"
              }
            },
            "required": [
              "canonicalDocument"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "BLOCKED",
                  "LOSSY"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "canonicalDocument": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
