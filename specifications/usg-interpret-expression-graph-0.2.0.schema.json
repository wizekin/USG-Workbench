{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USG Interpretation Expression Graph Candidate 0.2.0",
  "type": "object",
  "required": ["candidateId", "sourceRef", "sourceSha256", "rootRef", "clauseRootRefs", "status", "sourceSpan", "nodes"],
  "properties": {
    "candidateId": {"type": "string", "minLength": 1},
    "sourceRef": {"type": "string", "minLength": 1},
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rootRef": {"type": "string", "minLength": 1},
    "clauseRootRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["RESOLVED", "AMBIGUOUS", "PARTIAL"]},
    "sourceSpan": {"$ref": "#/$defs/span"},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nodeId", "op", "sort", "operandRefs", "params", "sourceSpan", "derivationRefs"],
        "properties": {
          "nodeId": {"type": "string", "minLength": 1},
          "op": {"enum": ["REF", "PREDICATE", "OPERATOR", "COORDINATION", "CLAUSE_GROUP"]},
          "sort": {"enum": ["ENTITY", "PROPOSITION", "PROPOSITION_SET"]},
          "operandRefs": {"type": "array", "items": {"type": "string"}},
          "params": {"type": "object"},
          "sourceSpan": {"$ref": "#/$defs/span"},
          "derivationRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {
            "if": {"properties": {"op": {"const": "OPERATOR"}}, "required": ["op"]},
            "then": {
              "properties": {
                "sort": {"const": "PROPOSITION"},
                "params": {
                  "type": "object",
                  "required": ["operatorType", "operatorValue", "scopeTargetRef", "scopeTargetKind", "scopeTargetTokenRef", "scopeSourceSpan", "surfaceOrder"],
                  "properties": {
                    "operatorType": {"enum": ["NEGATION", "MODALITY", "TENSE", "ASPECT", "QUANTIFIER"]},
                    "operatorValue": {"type": "string", "minLength": 1},
                    "scopeTargetRef": {"type": "string", "minLength": 1},
                    "scopeTargetKind": {"enum": ["PREDICATE", "ARGUMENT"]},
                    "scopeTargetTokenRef": {"type": "string", "minLength": 1},
                    "scopeSourceSpan": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2},
                    "surfaceOrder": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"op": {"const": "COORDINATION"}}, "required": ["op"]},
            "then": {
              "properties": {
                "sort": {"const": "PROPOSITION_SET"},
                "operandRefs": {"type": "array", "minItems": 2},
                "params": {
                  "type": "object",
                  "required": ["operatorValue", "relation", "markerText", "markerSpan", "leftClauseRef", "rightClauseRef", "grouping"],
                  "properties": {
                    "operatorValue": {"enum": ["AND", "OR", "CONTRAST"]},
                    "relation": {"enum": ["COORDINATION_AND", "COORDINATION_OR", "CONTRAST"]},
                    "markerText": {"type": "string", "minLength": 1},
                    "markerSpan": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2},
                    "leftClauseRef": {"type": "string", "minLength": 1},
                    "rightClauseRef": {"type": "string", "minLength": 1},
                    "grouping": {"const": "LEFT_ASSOCIATIVE"}
                  }
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["start", "end", "offsetUnit"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "offsetUnit": {"const": "unicode_code_point"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
