{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usg:pfr:1.0:schema",
  "title": "USG Predicate-to-Frame Registry 1.0",
  "type": "object",
  "required": [
    "registryId",
    "registryVersion",
    "status",
    "baselines",
    "sourceVocabulary",
    "mappings",
    "nonMappings",
    "policy"
  ],
  "properties": {
    "registryId": {
      "const": "USG-PFR/1.0"
    },
    "registryVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "initial-baseline",
        "candidate",
        "approved",
        "deprecated"
      ]
    },
    "createdOn": {
      "type": "string",
      "format": "date"
    },
    "baselines": {
      "type": "object",
      "required": [
        "workbench",
        "pythonKernel"
      ],
      "properties": {
        "workbench": {
          "type": "object"
        },
        "pythonKernel": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "sourceVocabulary": {
      "type": "object",
      "required": [
        "semanticComposerPredicates",
        "semanticCoreEventPredicates",
        "semanticCoreStatePredicates",
        "semanticCoreRelationPredicates",
        "semanticCoreTransitivePredicates"
      ],
      "properties": {
        "semanticComposerPredicates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "semanticCoreEventPredicates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "semanticCoreStatePredicates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "semanticCoreRelationPredicates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "semanticCoreTransitivePredicates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mappingId",
          "status",
          "direction",
          "source",
          "target",
          "roleMap",
          "requiredSourceRoles",
          "requiredTargetRoles",
          "applicabilityConditions",
          "evidence"
        ],
        "properties": {
          "mappingId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CONDITIONAL_EXACT",
              "EXACT"
            ]
          },
          "direction": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "implementation",
              "version",
              "nodeType",
              "predicateIds",
              "argumentRoles"
            ]
          },
          "target": {
            "type": "object",
            "required": [
              "implementation",
              "version",
              "operator",
              "frame",
              "frameVersion",
              "situationKind"
            ]
          },
          "roleMap": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sourceRole",
                "targetRole"
              ]
            }
          },
          "requiredSourceRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredTargetRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "targetRoleConstraints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "targetRole",
                "requiredSemanticClass"
              ]
            }
          },
          "applicabilityConditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "semanticBasis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nonCoverage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "nonMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourcePredicateIds",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sourcePredicateIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "defaultForUnlistedPredicate",
        "unknownPredicateBehavior",
        "unmetApplicabilityBehavior",
        "semanticLossBehavior",
        "versioning"
      ]
    }
  },
  "additionalProperties": false
}
