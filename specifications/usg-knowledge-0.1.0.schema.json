{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/USG-Workbench/specifications/usg-knowledge-0.1.0.schema.json",
  "title": "USG Knowledge Bundle 0.1.0",
  "description": "Additive, provenance-bearing semantic knowledge interchange. Structural validity is not semantic truth or acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "namespace",
    "bundle_id",
    "created_at",
    "records",
    "sources",
    "evidence",
    "contexts",
    "mappings",
    "relations"
  ],
  "properties": {
    "contract": {
      "const": "USG-KNOWLEDGE/0.1.0"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "state": {
      "enum": [
        "CANDIDATE",
        "VALIDATED_FOR_PROFILE",
        "ACCEPTED",
        "DEPRECATED",
        "REJECTED",
        "UNRESOLVED"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "BCP-47 language tag or declared language-profile identifier."
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "state",
        "created_at",
        "source_ids",
        "evidence_ids",
        "payload"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "LEXICAL_FORM",
            "LEMMA",
            "LEXICAL_SENSE",
            "CONCEPT",
            "SEMANTIC_CLASS",
            "PREDICATE_FRAME"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes_id": {
          "$ref": "#/$defs/id"
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "context_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "payload": {
          "type": "object",
          "minProperties": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "LEXICAL_FORM"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "form",
                  "language",
                  "script"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "LEMMA"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "lemma",
                  "language",
                  "part_of_speech"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "LEXICAL_SENSE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "lemma_record_id",
                  "language",
                  "definition",
                  "sense_source_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "CONCEPT"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "concept_type",
                  "namespace",
                  "label"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SEMANTIC_CLASS"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "class_key",
                  "definition"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "PREDICATE_FRAME"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "required": [
                  "frame_key",
                  "version",
                  "roles"
                ]
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "source_type",
        "retrieved_at",
        "rights_status",
        "redistribution",
        "attribution"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "DICTIONARY",
            "LEXICAL_DATABASE",
            "CORPUS",
            "USG_DOCUMENT",
            "MODEL_PROPOSAL",
            "OTHER"
          ]
        },
        "source_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "license_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_status": {
          "enum": [
            "KNOWN_PERMITTED",
            "RESTRICTED",
            "UNKNOWN",
            "PROHIBITED",
            "INTERNAL"
          ]
        },
        "redistribution": {
          "enum": [
            "ALLOWED",
            "RESTRICTED",
            "UNKNOWN",
            "PROHIBITED",
            "NOT_APPLICABLE"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "evidence_type",
        "support_status",
        "captured_at",
        "transformation_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_type": {
          "enum": [
            "DEFINITION",
            "EXAMPLE",
            "ATTESTATION",
            "RELATION_OBSERVATION",
            "CANONICAL_DOCUMENT",
            "MODEL_SUGGESTION",
            "OTHER"
          ]
        },
        "support_status": {
          "enum": [
            "SUPPORTS",
            "CONTRADICTS",
            "NEUTRAL",
            "UNASSESSED"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "transformation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "context_type",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "context_type": {
          "enum": [
            "LANGUAGE",
            "DOMAIN",
            "DISCOURSE",
            "TIME",
            "TASK",
            "REGISTER",
            "REGION",
            "SOURCE"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "language_profile": {
          "$ref": "#/$defs/language"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_record_id",
        "target_record_id",
        "mapping_type",
        "state",
        "evidence_ids",
        "context_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_record_id": {
          "$ref": "#/$defs/id"
        },
        "target_record_id": {
          "$ref": "#/$defs/id"
        },
        "mapping_type": {
          "enum": [
            "EQUIVALENT",
            "OVERLAPPING",
            "NARROWER_THAN",
            "BROADER_THAN",
            "RELATED_TO",
            "UNRESOLVED"
          ]
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "context_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_record_id",
        "predicate",
        "object_record_id",
        "direction",
        "state",
        "evidence_ids",
        "context_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "subject_record_id": {
          "$ref": "#/$defs/id"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object_record_id": {
          "$ref": "#/$defs/id"
        },
        "direction": {
          "const": "DIRECTED"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "context_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "relation_registry_version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
