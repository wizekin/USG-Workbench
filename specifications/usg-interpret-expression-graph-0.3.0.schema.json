{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/USG-Workbench/specifications/usg-interpret-expression-graph-0.3.0.schema.json",
  "title": "USG Interpretation Expression Graph 0.3.0",
  "type": "object",
  "required": [
    "graphId",
    "graphVersion",
    "sourceRef",
    "sourceSha256",
    "status",
    "rootRefs",
    "nodes",
    "edges"
  ],
  "properties": {
    "graphId": {
      "type": "string",
      "minLength": 1
    },
    "graphVersion": {
      "const": "0.3.0"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "RESOLVED",
        "AMBIGUOUS",
        "PARTIAL"
      ]
    },
    "rootRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "sourceRef",
        "start",
        "end",
        "offsetUnit"
      ],
      "properties": {
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "offsetUnit": {
          "const": "unicode_code_point"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "nodeId",
        "nodeType",
        "status",
        "sourceSpans",
        "derivationRefs",
        "attributes"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "nodeType": {
          "enum": [
            "SOURCE",
            "LEXICAL_CANDIDATE",
            "MORPHOLOGY_CANDIDATE",
            "CONSTRUCTION_CANDIDATE",
            "PREDICATE_FRAME",
            "SEMANTIC_ROLE_BINDING",
            "ARGUMENT",
            "MODIFIER",
            "COORDINATION",
            "CLAUSE",
            "PROPOSITION",
            "OPERATOR",
            "DISCOURSE_MENTION",
            "REFERENCE_CANDIDATE",
            "DERIVATION"
          ]
        },
        "status": {
          "enum": [
            "RESOLVED",
            "AMBIGUOUS",
            "PARTIAL",
            "UNRESOLVED",
            "UNSUPPORTED"
          ]
        },
        "sourceSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "derivationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attributes": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "edgeId",
        "relationType",
        "fromRef",
        "toRef",
        "sourceSpans",
        "derivationRefs"
      ],
      "properties": {
        "edgeId": {
          "type": "string",
          "minLength": 1
        },
        "relationType": {
          "enum": [
            "EVIDENCE_FOR",
            "DERIVED_FROM",
            "REALIZES",
            "SELECTS_FRAME",
            "BINDS_ROLE",
            "FILLS_SLOT",
            "MODIFIES",
            "ATTACHES_TO",
            "COORDINATES",
            "EMBEDS",
            "SCOPES_OVER",
            "MENTIONS",
            "CANDIDATE_ANTECEDENT",
            "RESOLVES_TO",
            "RELATES_TO"
          ]
        },
        "fromRef": {
          "type": "string",
          "minLength": 1
        },
        "toRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "derivationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
