{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/USG-Workbench/executor-benchmark-fixtures-1.0.0.schema.json",
  "title": "USG Inference Executor Benchmark Fixtures 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "benchmark_version",
    "usg_profile",
    "fixtures"
  ],
  "properties": {
    "benchmark_id": {
      "const": "USG-INFERENCE-EXECUTOR-BENCHMARK"
    },
    "benchmark_version": {
      "const": "1.0.0"
    },
    "usg_profile": {
      "const": "USG-SEM/1.0"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "document",
          "task",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": "object"
          },
          "task": {
            "type": "object"
          },
          "expected": {
            "type": "object",
            "required": [
              "completion_status",
              "candidate_count",
              "diagnostics"
            ],
            "properties": {
              "completion_status": {
                "enum": [
                  "COMPLETE",
                  "INCOMPLETE",
                  "INVALID_INPUT",
                  "UNSUPPORTED"
                ]
              },
              "candidate_count": {
                "type": "integer",
                "minimum": 0
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
