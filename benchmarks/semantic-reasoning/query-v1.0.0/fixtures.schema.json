{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/USG-Workbench/structured-query-benchmark-1.0.0.schema.json",
  "title": "USG Structured Query Benchmark 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "benchmark_version",
    "fixtures"
  ],
  "properties": {
    "benchmark_id": {
      "const": "USG-STRUCTURED-QUERY-BENCHMARK"
    },
    "benchmark_version": {
      "const": "1.0.0"
    },
    "fixtures": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "document_ref",
          "query",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "document_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "benchmark_id",
              "fixture_id"
            ],
            "properties": {
              "benchmark_id": {
                "enum": [
                  "USG-INFERENCE-EXECUTOR-BENCHMARK",
                  "USG-EVIDENCE-ASSESSMENT-BENCHMARK"
                ]
              },
              "fixture_id": {
                "type": "string"
              }
            }
          },
          "query": {
            "type": "object"
          },
          "expected": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
