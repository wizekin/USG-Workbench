{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizekin.github.io/usg-workbench/semantic-reasoning-benchmark/v1.0.0/fixtures.schema.json",
  "title": "USG Semantic Reasoning Benchmark Fixture Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "benchmark_version",
    "usg_profile",
    "description",
    "fixture_count",
    "fixtures"
  ],
  "properties": {
    "benchmark_id": {
      "const": "USG-SEMANTIC-REASONING"
    },
    "benchmark_version": {
      "const": "1.0.0"
    },
    "usg_profile": {
      "const": "USG-SEM/1.0"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "fixture_count": {
      "type": "integer",
      "minimum": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "case_types",
        "title",
        "versions",
        "input_snapshot",
        "task",
        "expected",
        "determinism_required",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^USG-BENCH-[A-Z0-9-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "case_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "positive",
              "negative",
              "boundary",
              "adversarial",
              "ambiguous",
              "unresolved",
              "conflicting",
              "unsupported",
              "incomplete"
            ]
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usg_sem_profile",
            "workbench",
            "python_document_adapter",
            "benchmark_format",
            "reference_policy"
          ],
          "properties": {
            "usg_sem_profile": {
              "const": "1.0"
            },
            "workbench": {
              "type": "string",
              "minLength": 1
            },
            "python_document_adapter": {
              "type": "string",
              "minLength": 1
            },
            "benchmark_format": {
              "const": "1.0.0"
            },
            "reference_policy": {
              "const": "benchmark-reference-policy/1.0.0"
            }
          }
        },
        "input_snapshot": {
          "type": "object",
          "required": [
            "profile_id",
            "document_id",
            "source_records",
            "semantic_records"
          ],
          "properties": {
            "profile_id": {
              "const": "USG-SEM/1.0"
            },
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "source_records": {
              "type": "array"
            },
            "semantic_records": {
              "type": "object"
            }
          }
        },
        "task": {
          "type": "object",
          "required": [
            "goal",
            "assumptions",
            "reference_policy"
          ],
          "properties": {
            "goal": {
              "type": "string",
              "minLength": 1
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reference_policy": {
              "type": "object",
              "required": [
                "id",
                "rules",
                "world_assumption"
              ],
              "properties": {
                "id": {
                  "const": "benchmark-reference-policy/1.0.0"
                },
                "rules": {
                  "type": "array"
                },
                "world_assumption": {
                  "enum": [
                    "OPEN",
                    "CLOSED"
                  ]
                }
              }
            },
            "execution_budget": {
              "type": "object"
            },
            "resource_policy": {
              "type": "string"
            },
            "repeat_count": {
              "type": "integer",
              "minimum": 2
            },
            "determinism_policy": {
              "type": "string"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completion_status",
            "conclusions",
            "prohibited_conclusions",
            "diagnostics",
            "scope_checks",
            "evidence_checks",
            "required_derivations",
            "preserved_item_ids"
          ],
          "properties": {
            "completion_status": {
              "enum": [
                "complete",
                "partial",
                "ambiguous",
                "unresolved",
                "unsupported",
                "conflicting",
                "incomplete"
              ]
            },
            "conclusions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "prohibited_conclusions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "diagnostics": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "scope_checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "check_id",
                  "expected_binding"
                ],
                "properties": {
                  "check_id": {
                    "type": "string"
                  },
                  "expected_binding": {
                    "type": "object"
                  }
                }
              }
            },
            "evidence_checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "check_id",
                  "expected_assessment"
                ],
                "properties": {
                  "check_id": {
                    "type": "string"
                  },
                  "expected_assessment": {
                    "type": "object"
                  }
                }
              }
            },
            "required_derivations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "conclusion_id",
                  "derivation_id",
                  "required_fields",
                  "expected_fields"
                ],
                "properties": {
                  "conclusion_id": {
                    "type": "string"
                  },
                  "derivation_id": {
                    "type": "string"
                  },
                  "required_fields": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "expected_fields": {
                    "type": "object"
                  }
                }
              }
            },
            "preserved_item_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "resource_expectations": {
              "type": "object",
              "required": [
                "expected_interrupted",
                "expected_truncated",
                "expected_input_item_count",
                "minimum_preserved_items"
              ],
              "properties": {
                "expected_interrupted": {
                  "type": "boolean"
                },
                "expected_truncated": {
                  "type": "boolean"
                },
                "expected_input_item_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "minimum_preserved_items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "determinism_required": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 40
        }
      }
    }
  }
}
