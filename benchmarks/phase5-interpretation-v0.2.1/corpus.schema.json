{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USG Interpretation Benchmark v0.2.1",
  "type": "object",
  "required": [
    "benchmark_id",
    "version",
    "contract",
    "annotation_profile",
    "scope",
    "offset_unit",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "const": "usg-interpretation-v0.2.1-balanced-foundation"
    },
    "version": {
      "const": "0.2.1"
    },
    "contract": {
      "const": "USG-INTERPRET/0.2.0"
    },
    "annotation_profile": {
      "const": "USG-INTERPRET-GOLD/0.2.1"
    },
    "scope": {
      "const": "simple_transitive_declarative_en_svo_ar_vso_svo"
    },
    "offset_unit": {
      "const": "unicode_code_point"
    },
    "cases": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "language",
          "text",
          "gold_class",
          "expected_completion_status",
          "expected_construction",
          "expected_roles",
          "expected_role_spans"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "en",
              "ar"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "gold_class": {
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "AMBIGUOUS"
            ]
          },
          "expected_completion_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "COMPLETE",
              "UNSUPPORTED",
              "AMBIGUOUS",
              "PARTIAL",
              null
            ],
            "description": "Exact completion status is annotated only for positive target-construction cases. For negative and ambiguous target-class cases, null means that the overall pipeline may legitimately return PARTIAL or COMPLETE for supported multi-clause content; construction abstention is evaluated separately."
          },
          "expected_construction": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_roles": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expected_role_spans": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "start",
                "end",
                "surface"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "surface": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
