{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "USG Interpretation Benchmark v0.1.0",
  "type": "object",
  "required": [
    "benchmark_id",
    "version",
    "contract",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "type": "string"
    },
    "version": {
      "const": "0.1.0"
    },
    "contract": {
      "const": "USG-INTERPRET/0.1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "language",
          "text",
          "expected_completion_status",
          "expected_expression_count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "language": {
            "enum": [
              "en",
              "ar"
            ]
          },
          "text": {
            "type": "string"
          },
          "expected_completion_status": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "AMBIGUOUS",
              "UNSUPPORTED",
              "INVALID_INPUT",
              "INCOMPLETE_RESOURCE_LIMIT",
              "FAILED_VALIDATION"
            ]
          },
          "expected_expression_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}\n