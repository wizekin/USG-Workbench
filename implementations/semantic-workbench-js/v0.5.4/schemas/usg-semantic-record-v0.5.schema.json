{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usg:schemas:semantic-record:0.5.1",
  "title": "USG Semantic Record v0.5",
  "description": "Candidate semantic interpretation with a canonical compositional expression graph. Valid structure is not proof of semantic correctness or truth.",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "sourceText",
    "claims",
    "representationProfile",
    "validation",
    "semanticModel",
    "semanticValidation"
  ],
  "properties": {
    "schema": {
      "const": "USG-SEMANTIC-RECORD"
    },
    "schemaVersion": {
      "const": "0.5.1"
    },
    "representationProfile": {
      "const": "USG-SR/0.5.1"
    },
    "analyzedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ok": {
      "type": "boolean"
    },
    "engine": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "interpretation": {
      "type": "string"
    },
    "sourceText": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRegistryEntry"
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      }
    },
    "claimRelations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimRelation"
      }
    },
    "explanations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "semanticModel": {
      "$ref": "#/$defs/semanticModel"
    },
    "semanticValidation": {
      "$ref": "#/$defs/semanticValidation"
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "text",
        "canonicalText",
        "surfaceText",
        "type",
        "reference"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "canonicalText": {
          "type": "string",
          "minLength": 1
        },
        "surfaceText": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "reference": {
          "enum": [
            "definite",
            "indefinite",
            "unmarked",
            "unknown",
            "resolved_pronoun"
          ]
        },
        "entityId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "proposition": {
      "type": "object",
      "required": [
        "subject",
        "predicate",
        "object",
        "polarity",
        "tense",
        "modality"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/entity"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "oneOf": [
            {
              "$ref": "#/$defs/entity"
            },
            {
              "type": "null"
            }
          ]
        },
        "polarity": {
          "enum": [
            "positive",
            "negative",
            "unknown"
          ]
        },
        "tense": {
          "enum": [
            "past",
            "present",
            "future",
            "unknown"
          ]
        },
        "modality": {
          "enum": [
            "asserted",
            "possible",
            "necessary",
            "obligatory",
            "possible_or_ability",
            "expected",
            "unknown"
          ]
        },
        "time": {
          "type": "object"
        },
        "modalScope": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "condition": {
      "type": "object",
      "required": [
        "id",
        "marker",
        "scope",
        "effect",
        "proposition",
        "logicalStatus"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "marker": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "proposition": {
          "oneOf": [
            {
              "$ref": "#/$defs/proposition"
            },
            {
              "type": "null"
            }
          ]
        },
        "consequence": {
          "type": "string"
        },
        "evidenceText": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "logicalStatus": {
          "enum": [
            "conditional_not_asserted",
            "unresolved_proposition"
          ]
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "sourceText",
        "quote",
        "start",
        "end",
        "verified"
      ],
      "properties": {
        "sourceText": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "verified": {
          "type": "boolean"
        },
        "modelQuote": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelQuoteVerified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "claim": {
      "allOf": [
        {
          "$ref": "#/$defs/proposition"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "object",
        "polarity",
        "tense",
        "modality",
        "conditions",
        "completeness",
        "evidence",
        "provenance",
        "sourceKind",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "causalLinks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "modalScope": {
          "type": [
            "object",
            "null"
          ]
        },
        "time": {
          "type": [
            "object",
            "null"
          ]
        },
        "quantifierScope": {
          "type": [
            "object",
            "null"
          ]
        },
        "comparisonFrame": {
          "type": [
            "object",
            "null"
          ]
        },
        "eventAttributes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "completeness": {
          "type": "object",
          "required": [
            "status",
            "missingRoles",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "underspecified",
                "unresolved",
                "not_applicable"
              ]
            },
            "missingRoles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "semanticStatus": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "provenance": {
          "type": "string"
        },
        "sourceKind": {
          "type": "string"
        },
        "ruleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "createdAt": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "entityRegistryEntry": {
      "type": "object",
      "required": [
        "id",
        "canonicalText",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "canonicalText": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "mention": {
      "type": "object",
      "required": [
        "entityId",
        "surfaceText",
        "canonicalText",
        "mentionType",
        "antecedentId"
      ],
      "properties": {
        "entityId": {
          "type": "string"
        },
        "surfaceText": {
          "type": "string"
        },
        "canonicalText": {
          "type": "string"
        },
        "mentionType": {
          "type": "string"
        },
        "antecedentId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claimRelation": {
      "type": "object",
      "required": [
        "id",
        "type",
        "fromClaimId",
        "toClaimId",
        "scope",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "CONTRADICTS",
            "SUPPORTS",
            "ATTACKS",
            "RELATED_TO"
          ]
        },
        "fromClaimId": {
          "type": "string"
        },
        "toClaimId": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "enum": [
            "candidate",
            "accepted",
            "rejected"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "claimCount",
        "unresolvedCount",
        "underspecifiedCount",
        "allClaimsRequireReview"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "partial",
            "unresolved"
          ]
        },
        "claimCount": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedCount": {
          "type": "integer",
          "minimum": 0
        },
        "underspecifiedCount": {
          "type": "integer",
          "minimum": 0
        },
        "allClaimsRequireReview": {
          "const": true
        }
      }
    },
    "semanticEntity": {
      "type": "object",
      "required": [
        "id",
        "canonicalText",
        "type",
        "aliases",
        "identityStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "canonicalText": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identityStatus": {
          "enum": [
            "source_linked",
            "provisional",
            "reviewed",
            "unresolved"
          ]
        }
      },
      "additionalProperties": true
    },
    "semanticMention": {
      "type": "object",
      "required": [
        "id",
        "entityId",
        "surfaceText",
        "mentionType",
        "resolutionStatus"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "entityId": {
          "type": [
            "string",
            "null"
          ]
        },
        "surfaceText": {
          "type": "string"
        },
        "mentionType": {
          "type": "string"
        },
        "resolutionStatus": {
          "enum": [
            "linked",
            "resolved",
            "unresolved"
          ]
        },
        "antecedentEntityId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceSpan": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "semanticEvidence": {
      "type": "object",
      "required": [
        "id",
        "sourceText",
        "quote",
        "start",
        "end",
        "exactSourceMatch",
        "verificationMeaning"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceText": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "exactSourceMatch": {
          "type": "boolean"
        },
        "modelQuote": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelQuoteVerified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "verificationMeaning": {
          "const": "source_alignment_only_not_semantic_entailment"
        }
      },
      "additionalProperties": true
    },
    "semanticArgument": {
      "type": "object",
      "required": [
        "role",
        "entityId",
        "mentionId"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "entityId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mentionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "variableId": {
          "type": [
            "string",
            "null"
          ]
        },
        "bindingEntityId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "predicationExpression": {
      "type": "object",
      "required": [
        "id",
        "type",
        "predicate",
        "arguments",
        "argumentRequirements",
        "grammaticalTense",
        "aspect",
        "temporalFrame",
        "attribution",
        "provenance",
        "completeness",
        "evidenceRefs",
        "sourceClaimId",
        "eventFrame"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "PREDICATION"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/semanticArgument"
          }
        },
        "grammaticalTense": {
          "enum": [
            "past",
            "present",
            "future",
            "unknown"
          ]
        },
        "aspect": {
          "enum": [
            "simple",
            "progressive",
            "perfect",
            "habitual",
            "unknown"
          ]
        },
        "temporalFrame": {
          "type": "object",
          "required": [
            "referenceTime",
            "temporalAdverbials",
            "sourceTense",
            "clauseEvidence"
          ],
          "properties": {
            "referenceTime": {
              "type": "string"
            },
            "temporalAdverbials": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sourceTense": {
              "type": "string"
            },
            "clauseEvidence": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "attribution": {
          "type": "object",
          "required": [
            "kind",
            "status",
            "truthStatus"
          ],
          "properties": {
            "kind": {
              "const": "source_voice"
            },
            "status": {
              "type": "string"
            },
            "truthStatus": {
              "const": "not_independently_established"
            }
          },
          "additionalProperties": true
        },
        "provenance": {
          "type": "object"
        },
        "completeness": {
          "type": "object",
          "required": [
            "status",
            "missingRoles"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "underspecified",
                "unresolved",
                "not_applicable"
              ]
            },
            "missingRoles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceClaimId": {
          "type": [
            "string",
            "null"
          ]
        },
        "eventFrame": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "predicate",
            "participants",
            "attributes"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "event",
                "state",
                "relation",
                "unknown"
              ]
            },
            "predicate": {
              "type": "string"
            },
            "participants": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "role",
                  "entityId"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "entityId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "variableId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "bindingEntityId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              }
            },
            "attributes": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        },
        "argumentRequirements": {
          "type": "object",
          "required": [
            "requiredRoles",
            "missingRoles"
          ],
          "properties": {
            "requiredRoles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missingRoles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "operatorExpression": {
      "type": "object",
      "required": [
        "id",
        "type",
        "operatorType",
        "operator",
        "scope",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "OPERATOR"
        },
        "operatorType": {
          "enum": [
            "NEGATION",
            "MODAL",
            "QUANTIFIER",
            "POLARITY",
            "UNRESOLVED_SCOPE"
          ]
        },
        "operator": {
          "type": "string"
        },
        "force": {
          "type": [
            "string",
            "null"
          ]
        },
        "variable": {
          "type": [
            "string",
            "null"
          ]
        },
        "restrictor": {
          "type": [
            "object",
            "null"
          ]
        },
        "scope": {
          "type": "object",
          "required": [
            "targetId",
            "scopeKind"
          ],
          "properties": {
            "targetId": {
              "type": "string"
            },
            "scopeKind": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "surfaceText": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variableBinding": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "variable": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "restrictorEntityId": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "connectiveExpression": {
      "type": "object",
      "required": [
        "id",
        "type",
        "connective"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "CONNECTIVE"
        },
        "connective": {
          "enum": [
            "CONDITIONAL",
            "EXCEPTION",
            "AND",
            "OR",
            "CONTRAST",
            "WHEN",
            "CONCESSIVE"
          ]
        },
        "antecedentId": {
          "type": "string"
        },
        "consequentId": {
          "type": "string"
        },
        "operandIds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "logicalStatus": {
          "enum": [
            "conditional_not_asserted",
            "unresolved_proposition",
            "exception_relation_asserted",
            "coordination_asserted",
            "when_clause_not_asserted"
          ]
        },
        "marker": {
          "type": "string"
        },
        "disjunctionSemantics": {
          "enum": [
            "inclusive_or_unspecified",
            "exclusive"
          ]
        },
        "attribution": {
          "type": "object"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "antecedentId",
            "consequentId"
          ]
        },
        {
          "required": [
            "operandIds"
          ]
        }
      ],
      "additionalProperties": true
    },
    "semanticExpression": {
      "oneOf": [
        {
          "$ref": "#/$defs/predicationExpression"
        },
        {
          "$ref": "#/$defs/operatorExpression"
        },
        {
          "$ref": "#/$defs/connectiveExpression"
        }
      ]
    },
    "semanticRelation": {
      "type": "object",
      "required": [
        "id",
        "type",
        "sourceExpressionId",
        "targetExpressionId",
        "attribution",
        "verification",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "CAUSE",
            "CONTRADICTS",
            "SUPPORTS",
            "ATTACKS",
            "RELATED_TO"
          ]
        },
        "sourceExpressionId": {
          "type": "string"
        },
        "targetExpressionId": {
          "type": "string"
        },
        "attribution": {
          "type": "object"
        },
        "verification": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
